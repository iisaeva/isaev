local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local gui = Instance.new("ScreenGui")
gui.Name = "MaintenanceMessage"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.Parent = playerGui

local text = Instance.new("TextLabel")
text.AnchorPoint = Vector2.new(0.5, 0.5)
text.Position = UDim2.fromScale(0.5, 0.5)
text.Size = UDim2.fromScale(0.85, 0.15)

text.BackgroundTransparency = 1
text.Text = "scripts down for maintenance mb homie - drowsy"
text.TextColor3 = Color3.fromRGB(255, 255, 255)
text.TextTransparency = 1

text.Font = Enum.Font.GothamBold
text.TextScaled = true
text.TextWrapped = true
text.Parent = gui

local sizeConstraint = Instance.new("UITextSizeConstraint")
sizeConstraint.MaxTextSize = 38
sizeConstraint.MinTextSize = 16
sizeConstraint.Parent = text

local scale = Instance.new("UIScale")
scale.Scale = 0.7
scale.Parent = text

local fadeIn = TweenService:Create(
	text,
	TweenInfo.new(
		0.8,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out
	),
	{
		TextTransparency = 0
	}
)

local zoomIn = TweenService:Create(
	scale,
	TweenInfo.new(
		0.8,
		Enum.EasingStyle.Back,
		Enum.EasingDirection.Out
	),
	{
		Scale = 1
	}
)

fadeIn:Play()
zoomIn:Play()

task.delay(3.5, function()
	if gui then
		gui:Destroy()
	end
end)

zoomIn.Completed:Wait()

while gui.Parent do
	local grow = TweenService:Create(
		scale,
		TweenInfo.new(
			1.5,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut
		),
		{
			Scale = 1.035
		}
	)

	grow:Play()
	grow.Completed:Wait()

	if not gui.Parent then
		break
	end

	local shrink = TweenService:Create(
		scale,
		TweenInfo.new(
			1.5,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut
		),
		{
			Scale = 1
		}
	)

	shrink:Play()
	shrink.Completed:Wait()
end
